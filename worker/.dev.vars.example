# Copy this file to .dev.vars (same folder) and paste your Panta API key after the = sign.
# .dev.vars is gitignored. Never commit a real key.
PANTA_API_KEY=
# Claude API key, used by /detect and /match.
ANTHROPIC_API_KEY=
# Helius mainnet RPC URL, used for balances, simulation, and sending. The URL contains a key.
HELIUS_RPC_URL=
# Any long random string (32+ characters). Sent as X-Soothia-Admin to read /debug/* routes.
ADMIN_TOKEN=
